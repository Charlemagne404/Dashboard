  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "utils/passwords.js", "utils/mfa.js", "utils/runtimeConfig.js",
    "utils/sessionPolicy.js", "utils/clientIp.js", "utils/identityScope.js",
    "utils/browserSecurity.js", "utils/safeLog.js"
  ]
}
