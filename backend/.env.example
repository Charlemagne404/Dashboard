NODE_ENV=development
APP_NAME=continental-id-auth
HOST=127.0.0.1
PORT=5000
MONGO_URI=mongodb://localhost:27017/continental_dashboard
JWT_SECRET=replace-with-a-long-random-secret
REFRESH_TOKEN_SECRET=replace-with-a-second-long-random-secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
SESSION_ABSOLUTE_TTL_MS=604800000
SESSION_IDLE_TTL_MS=86400000
TRUST_PROXY=false
HTTPS_MODE=off

# Mandatory in production; use the canonical identity API host, not an app proxy.
# PUBLIC_API_ORIGIN=https://auth.continental-hub.com
# IDENTITY_MANAGEMENT_ORIGINS=https://dashboard.continental-hub.com,https://login.continental-hub.com
# MFA_SECRET_ENCRYPTION_KEY=replace-with-a-third-long-random-secret
# When HTTP is reachable only through one trusted local TLS proxy, set TRUST_PROXY=1.
# Existing encrypted MFA secrets and backup codes remain readable through their prior
# server key while REFRESH_TOKEN_SECRET stays unchanged. Rotate/re-encrypt deliberately.
# Production requires explicit lists and rejects enabling built-in defaults.
ALLOW_DEFAULT_TRUSTED_ORIGINS=false

# Comma-separated list of trusted frontend origins allowed by CORS.
ALLOWED_ORIGINS=https://charlemagne404.github.io,https://dashboard.continental-hub.com,https://login.continental-hub.com,https://terra-tread.continental-hub.com
# Localhost/127.0.0.1 origins are development-only; production rejects this switch.
# ALLOW_LOCALHOST_ORIGINS=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=180
LOGIN_RATE_WINDOW_MS=600000
LOGIN_RATE_MAX_ATTEMPTS=8
LOGIN_BLOCK_MS=900000
MFA_RATE_WINDOW_MS=600000
MFA_RATE_MAX_ATTEMPTS=5
MFA_BLOCK_MS=900000
PASSWORD_RESET_TTL_MS=3600000
PASSWORD_RESET_EMAIL_COOLDOWN_MS=600000
VERIFICATION_EMAIL_COOLDOWN_MS=1800000
EMAIL_DAILY_LIMIT=100
EMAIL_MONTHLY_LIMIT=3000
REFRESH_TOKEN_REPLAY_GRACE_MS=15000

# Optional HTTPS cert paths for direct TLS. Set HTTPS_MODE=on to require them,
# or HTTPS_MODE=auto to enable HTTPS only when both files are present.
HTTPS_KEY_PATH=/etc/letsencrypt/live/mpmc.ddns.net/privkey.pem
HTTPS_CERT_PATH=/etc/letsencrypt/live/mpmc.ddns.net/fullchain.pem

# Required in production; optional only for local development.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM=no-reply@example.com
# EMAIL_FROM_NAME=Continental ID
# EMAIL_REPLY_TO=support@example.com
# LOGIN_POPUP_URL=https://login.continental-hub.com/popup.html
# EMAIL_VERIFY_URL=https://login.continental-hub.com/verify.html
# EMAIL_VERIFICATION_TTL_MS=86400000
# EMAIL_HERO_IMAGE_URL=https://dashboard.continental-hub.com/email-hero.png

# COOKIE_DOMAIN only affects the non-authenticating device-recognition cookie.
# Production refresh cookies remain host-only regardless of this setting.

# Optional WebAuthn/passkey configuration.
# WEBAUTHN_RP_NAME=Continental ID
# WEBAUTHN_RP_ID=continental-hub.com

# Optional OAuth provider configuration.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_OAUTH_CALLBACK_URL=https://auth.example.com/api/auth/oauth/github/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_OAUTH_CALLBACK_URL=https://auth.example.com/api/auth/oauth/google/callback
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_OAUTH_CALLBACK_URL=https://auth.example.com/api/auth/oauth/discord/callback
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=common
# MICROSOFT_OAUTH_CALLBACK_URL=https://auth.example.com/api/auth/oauth/microsoft/callback

# Optional Vanguard service integration.
# VANGUARD_API_KEY=replace-with-a-shared-secret-used-by-the-bot
# VANGUARD_API_KEYS=extra-secret-1,extra-secret-2
# VANGUARD_API_KEY_HEADER=X-Vanguard-Api-Key
# VANGUARD_INSTANCE_HEADER=X-Vanguard-Instance-Id
# VANGUARD_LICENSE_AUTHORIZED=true
# VANGUARD_LICENSE_REASON=active license
# VANGUARD_ALLOWED_GUILD_IDS=123456789012345678,234567890123456789
# VANGUARD_ENTITLEMENT_AI=true
# VANGUARD_ENTITLEMENT_ADVANCED_VOTES=true
# VANGUARD_ENTITLEMENT_GUARD_PRESETS=balanced,strict
